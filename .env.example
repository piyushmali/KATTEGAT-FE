# KATTEGAT frontend configuration.
# Copy to `.env.local`. Everything here is NEXT_PUBLIC_* and therefore inlined into the
# browser bundle by Next at build time — never put a secret in this file.
#
# Validated at startup by src/config/env.ts, which fails loudly rather than falling back.

# Base URL of the KATTEGAT backend, without a trailing slash.
#
# Local for development. In production this is the deployed API, e.g.
# https://kattegat-be.onrender.com — and the backend's CORS_ORIGINS must name this app's
# origin in return, or every browser request is blocked while curl keeps working.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Data source for the frontend:
#   live  — call the backend at NEXT_PUBLIC_API_BASE_URL
#   mock  — serve fixtures from src/lib/api/mock-data.ts
#
# `mock` exists so frontend work is never blocked on a running backend or a
# synced database (see docs/development.md). It uses the same Zod contract as
# `live`, so a fixture that drifts from the API contract fails loudly.
#
# Hiring and escrow report themselves as unavailable in `mock`, because a synthetic session
# would render a spend cap and a revoke button for authority that does not exist.
NEXT_PUBLIC_DATA_SOURCE=live

# BNB Smart Chain read endpoint for wallet network checks. Must be a chain-56 endpoint.
#
# Keep this a PUBLIC endpoint. It is used by the wagmi transport in src/lib/web3/wagmi.ts,
# which runs in the browser, so whatever is set here is readable by anyone who opens the site.
# Putting a keyed endpoint here publishes the key, and the quota it burns is the one the
# backend's ingestion depends on. Keyed endpoints belong in the backend's BSC_RPC_URL.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-rpc.publicnode.com
